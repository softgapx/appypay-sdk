<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.softgapx</groupId>
    <artifactId>appypay-sdk-spring-boot-starter</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>AppyPay SDK - Spring Boot Starter</name>
    <description>
        Auto-configuração Spring Boot para o appypay-sdk-core: basta
        configurar application.properties/yml para ter o PaymentService
        disponível para @Autowired, sem escrever nenhuma classe
        @Configuration manualmente.
    </description>
    <url>https://github.com/softgapx/appypay-sdk</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Bruno Ramos Juca Samuel</name>
            <email>bruno.samuel@softgapx.com</email>
            <organization>SoftGapX</organization>
            <organizationUrl>https://softgapx.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/softgapx/appypay-sdk.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/softgapx/appypay-sdk.git</developerConnection>
        <url>https://github.com/softgapx/appypay-sdk</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.4.1</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- O SDK puro — única dependência "de negócio" deste starter. -->
        <dependency>
            <groupId>com.softgapx</groupId>
            <artifactId>appypay-sdk-core</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Infraestrutura de auto-configuração do Spring Boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Gera META-INF/spring-configuration-metadata.json, para que
             o application.properties/yml tenha autocompletar e
             descrição das propriedades appypay.* no IDE. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Gera o -sources.jar, obrigatório pelo Central. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Gera o -javadoc.jar, obrigatório pelo Central. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.10.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <!--
            Assinatura GPG e publicação no Central Portal só acontecem
            quando este profile é ativado explicitamente:

                mvn clean deploy -P release

            Um `mvn install`/`mvn test` do dia a dia NÃO assina nada
            nem tenta publicar.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>

                    <!-- Assina jar, sources.jar e javadoc.jar com GPG. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Empacota tudo (jar + sources + javadoc + .asc) e
                         envia para o Sonatype Central Portal. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>

</project>
